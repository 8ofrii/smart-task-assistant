PORT=3000

# PostgreSQL / Aiven
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:11777/defaultdb
DB_POOL_MAX=10

# For Aiven:
DB_SSL=true
# Recommended: download the Aiven CA certificate and set its local path.
DB_CA_CERT_PATH=./certs/ca.pem
# If you do not have the CA file yet, set this false temporarily for local testing.
DB_SSL_REJECT_UNAUTHORIZED=true

# LLM provider: openrouter | openai | gemini | fallback
LLM_PROVIDER=openrouter

# OpenRouter / OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Gemini (optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional internal debug logging
LOG_PARSE_SOURCE=true